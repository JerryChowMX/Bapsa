{
  "name": "bapsa",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio de BAPSA · Equipo de Elevación — Ramos Arizpe, Coahuila.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run test",
    "build:only": "astro build",
    "preview": "astro preview",
    "test": "npm run test:seo && npm run test:enlaces",
    "test:seo": "python3 scripts/audit.py ./dist --base-url https://www.bapsa.com.mx --strict",
    "test:enlaces": "python3 scripts/verificar.py ./dist",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  }
}
