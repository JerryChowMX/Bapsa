---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icono from "../components/Icono.astro";
import PlacaDatos from "../components/PlacaDatos.astro";
import Foto from "../components/Foto.astro";
import LlamadoAccion from "../components/LlamadoAccion.astro";
import { SITE } from "../config/seo";
import { FAMILIAS_DATOS } from "../datos/familias";
import { MAQUINAS, MAQUINAS_POR_ALTURA, MARCAS_CATALOGO } from "../datos/maquinas";
import { nodoServicio, nodoListaMaquinas } from "../lib/schema";

const masAlta = MAQUINAS_POR_ALTURA[0];

/** La foto del héroe. Astro la recorta a cuatro anchos y la sirve en AVIF y
 *  WebP en el build; el JPEG de src/fotos es solo el original. */
import fotoHeroe from "../fotos/13_jlg_brazo_articulado_atardecer_nave_industrial.jpg";

/** Una foto por familia, elegida a mano del material del cliente. Se
 *  recortan a 16:10 con object-fit; el punto de interés queda al centro. */
import fotoBrazos from "../fotos/32_genie_z30_brazo_articulado_patio.jpg";
import fotoTijeras from "../fotos/14_jlg_2632es_plataforma_tijera_camion_transporte.jpg";
import fotoElevadores from "../fotos/09_jlg_plataformas_compactas_dobles.jpg";
import fotoPesada from "../fotos/36_jlg_1200sjp_sobre_lowboy_planta.jpg";
const FOTO_FAMILIA: Record<string, ImageMetadata> = {
  "brazos-articulados-electricos": fotoBrazos,
  "plataformas-de-tijera": fotoTijeras,
  "elevadores-personales": fotoElevadores,
  "maquinaria-pesada": fotoPesada,
};

const schema = [
  nodoServicio({
    nombre: "Renta de equipo de elevación",
    descripcion: SITE.description,
    ruta: "/renta",
    tipo: "Renta de plataformas aéreas y brazos articulados",
  }),
  nodoListaMaquinas(
    `${SITE.url}/equipo#catalogo`,
    "Catálogo de equipo de elevación en renta",
    MAQUINAS_POR_ALTURA.map((m) => ({ nombre: `${m.marca} ${m.modelo}`, ruta: `/equipo/${m.slug}` }))
  ),
];
---

<Base
  titulo="Renta de plataformas aéreas en Ramos Arizpe"
  tituloCompleto="BAPSA — Renta de plataformas aéreas en Ramos Arizpe"
  descripcion={SITE.description}
  ruta="/"
  schema={schema}
  barraSobreFoto
>
  {/* Héroe. Estructura tomada de la referencia «Responsive Hero Banner» de
      21st.dev: una foto de pantalla completa con velo oscuro, titular grande,
      una frase, dos botones y la fila de marcas al pie. La foto es el
      argumento; el texto va a la izquierda porque la máquina ocupa la
      derecha. */}
  <section class="heroe banda--azul" aria-labelledby="heroe-titulo">
    <Picture
      src={fotoHeroe}
      formats={["avif", "webp"]}
      widths={[640, 960, 1440, 1920]}
      sizes="(max-width: 719px) 1500px, 100vw"
      alt="Brazo articulado JLG de BAPSA con la canastilla elevada frente a una nave industrial, al atardecer."
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="heroe__img"
      pictureAttributes={{ class: "heroe__foto" }}
    />
    <div class="heroe__velo" aria-hidden="true"></div>

    <div class="hoja heroe__contenido">
      <h1 class="heroe__titulo heroe__paso" id="heroe-titulo" style="--paso: 0">
        Renta de plataformas y&nbsp;brazos articulados
      </h1>
      <p class="heroe__frase heroe__paso" style="--paso: 1">
        Equipo eléctrico con flete propio en Ramos Arizpe, Saltillo y Arteaga.
      </p>
      <div class="heroe__acciones heroe__paso" style="--paso: 2">
        <a class="btn btn--sobre-azul btn--grande" href="/contacto">
          Pedir cotización
          <Icono nombre="flecha" tam={16} />
        </a>
        <a class="btn btn--contorno-claro btn--grande" href="/equipo">Ver las {MAQUINAS.length} máquinas</a>
      </div>
    </div>

    {/* Las marcas que atiende el taller, en marquesina al pie del héroe. La
        primera lista es la que leen lectores de pantalla y crawlers; la copia
        hace continuo el rodado y va oculta para ellos. */}
    <div class="hoja heroe__marcas heroe__paso" style="--paso: 5">
      <p class="heroe__marcas-rotulo">Taller y refacciones para</p>
      <div class="marquesina">
        <ul class="marquesina__pista">
          {SITE.marcas.map((m) => <li>{m}</li>)}
        </ul>
        <ul class="marquesina__pista" aria-hidden="true">
          {SITE.marcas.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* Equipo en renta. Estructura tomada de la referencia «Features 8» de
      Tailark en 21st.dev: una bento de celdas con un área visual grande
      arriba, título y una sola línea centrados, sin botones. El visual es
      la foto de cada familia, con su cifra clave encima. */}
  <section class="seccion banda--neblina" aria-labelledby="familias-titulo">
    <div class="hoja">
      <h2 class="titulo-2 familias__titulo" id="familias-titulo">
        Cuatro familias, un criterio para elegir
      </h2>
      <div class="filete filete--centrado"></div>

      <ul class="bento">
        {
          FAMILIAS_DATOS.map((f, i) => (
            <li class="celda" style={`--i: ${i}`}>
              <a class="celda__enlace" href={`/renta/${f.slug}`}>
                <div class="celda__visual">
                  {FOTO_FAMILIA[f.slug] && (
                    <Picture
                      src={FOTO_FAMILIA[f.slug]}
                      formats={["avif", "webp"]}
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 980px) 640px, (min-width: 720px) 50vw, 100vw"
                      alt={f.fotoAlt}
                      loading="lazy"
                      decoding="async"
                      class="celda__img"
                      pictureAttributes={{ class: "celda__foto" }}
                    />
                  )}
                  {f.medidas.length > 0 && (
                    <span class="celda__cifra">
                      <span class="dato celda__valor">{f.medidas[0].valor}</span>
                      <span class="celda__concepto">{f.medidas[0].concepto}</span>
                    </span>
                  )}
                </div>
                <h3 class="titulo-3 celda__titulo">{f.nombre}</h3>
                <p class="chico celda__texto">{f.resumen}</p>
                <span class="celda__ver">
                  Ver detalle
                  <Icono nombre="flecha" tam={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Catálogo. Patrón de tabla de datos de 21st.dev: filas con filete,
      etiqueta cuadrada de tipo, cifras a la derecha en voz de dato y una
      barra proporcional para comparar la altura de trabajo de un vistazo.
      Sigue siendo una <table> real: un crawler la extrae columna por
      columna. En celular cada fila se vuelve una ficha. */}
  <section class="seccion" aria-labelledby="catalogo-titulo">
    <div class="hoja">
      <h2 class="titulo-2 catalogo__titulo" id="catalogo-titulo">
        Las {MAQUINAS.length} máquinas, con su ficha de fabricante
      </h2>
      <div class="filete filete--centrado"></div>

      <div class="catalogo">
        <table class="catalogo__tabla">
          <caption class="solo-lectores">
            Equipo en renta de BAPSA, de mayor a menor altura de trabajo. Cifras de las fichas
            técnicas de Genie y JLG.
          </caption>
          <thead>
            <tr>
              <th scope="col">Modelo</th>
              <th scope="col">Tipo</th>
              <th scope="col" class="catalogo__col-altura">Altura de trabajo</th>
              <th scope="col" class="cifra">Capacidad</th>
              <th scope="col" class="cifra">Ancho</th>
              <th scope="col"><span class="solo-lectores">Ficha</span></th>
            </tr>
          </thead>
          <tbody>
            {
              MAQUINAS_POR_ALTURA.map((m, i) => {
                const esTijera = m.familia === "plataformas-de-tijera";
                const angosta = /angost/i.test(m.tipo);
                const proporcion = Math.round((m.alturaTrabajoM / masAlta.alturaTrabajoM) * 100);
                return (
                  <tr class="catalogo__fila" style={`--i: ${i}; --p: ${proporcion}%`}>
                    <th scope="row" class="catalogo__modelo">
                      <span class="catalogo__marca">{m.marca}</span>
                      <a href={`/equipo/${m.slug}`} class="catalogo__enlace">{m.modelo}</a>
                    </th>
                    <td class="catalogo__tipo" data-etiqueta="Tipo">
                      <span class:list={["tag", esTijera ? "tag--tijera" : "tag--brazo"]}>
                        {esTijera ? "Tijera" : "Brazo"}
                      </span>
                      {angosta && <span class="tag tag--nota">Angosta</span>}
                    </td>
                    <td class="catalogo__altura" data-etiqueta="Altura de trabajo">
                      <span class="barra-altura" aria-hidden="true">
                        <span class:list={["barra-altura__relleno", i === 0 && "barra-altura__relleno--max"]}></span>
                      </span>
                      <span class="dato catalogo__cifra">{m.alturaTrabajo}</span>
                    </td>
                    <td class="cifra dato catalogo__cap" data-etiqueta="Capacidad">{m.capacidad}</td>
                    <td class="cifra dato catalogo__ancho" data-etiqueta="Ancho">{m.ancho}</td>
                    <td class="catalogo__ir">
                      <a href={`/equipo/${m.slug}`} aria-label={`Ver la ficha del ${m.marca} ${m.modelo}`}>
                        <Icono nombre="flecha" tam={16} />
                      </a>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <div class="catalogo__pie">
        <p class="pie-foto">Cifras de las fichas técnicas de {MARCAS_CATALOGO.join(" y ")}. Todo el catálogo es eléctrico.</p>
        <a class="btn btn--azul" href="/equipo">
          Ver el catálogo completo
          <Icono nombre="flecha" tam={16} />
        </a>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="hoja rejilla rejilla--2 pareja">
      <div>
        <p class="etiqueta">Por qué BAPSA</p>
        <h2 class="titulo-2">Lo que cambia cuando el proveedor tiene taller</h2>
        <div class="filete"></div>
        <p>
          BAPSA opera desde Ramos Arizpe, sobre el corredor industrial entre Saltillo y
          Monterrey, con flete propio y taller propio. Las dos cosas resuelven el mismo problema:
          que la fecha de entrega y la reparación de una falla no dependan de la agenda de un
          tercero.
        </p>
        <ul class="lista-marcada">
          <li>
            <strong>Más de {SITE.aniosOperacion} años</strong> rentando equipo de elevación en
            Coahuila, no un catálogo recién abierto.
          </li>
          <li>
            <strong>Flete propio.</strong> La entrega en obra la programa BAPSA, no un
            transportista externo.
          </li>
          <li>
            <strong>Taller y refacciones multimarca</strong> para {SITE.marcas.join(", ")}: la
            falla se atiende sin esperar a un centro de servicio de otra ciudad.
          </li>
          <li>
            <strong>Pólizas de servicio</strong> para flotas propias, con mantenimiento
            preventivo programado.
          </li>
        </ul>
        <a class="btn btn--azul" href="/nosotros">Conocer la empresa</a>
      </div>
      <Foto
        alt="Taller de servicio de BAPSA en Ramos Arizpe, con un técnico dando mantenimiento a un brazo articulado."
        clave="FOTO-06"
        ancho={800}
        alto={600}
      />
    </div>
  </section>

  <section class="seccion banda--neblina">
    <div class="hoja">
      <p class="etiqueta">Además de la renta</p>
      <h2 class="titulo-2">Venta, servicio y refacciones</h2>
      <div class="filete"></div>
      <ul class="rejilla rejilla--3 servicios">
        <li class="tarjeta">
          <Icono nombre="cotizacion" tam={28} />
          <h3 class="titulo-3"><a href="/venta">Venta de equipo</a></h3>
          <p class="chico">
            Cuando la máquina se va a usar todo el año, comprarla sale más barato que rentarla.
            BAPSA vende equipo nuevo y seminuevo con respaldo de servicio.
          </p>
        </li>
        <li class="tarjeta">
          <Icono nombre="mantenimiento" tam={28} />
          <h3 class="titulo-3"><a href="/servicio">Servicio y pólizas</a></h3>
          <p class="chico">
            Mantenimiento preventivo y correctivo para equipo propio o rentado a otro proveedor,
            con póliza programada y bitácora por máquina.
          </p>
        </li>
        <li class="tarjeta">
          <Icono nombre="refacciones" tam={28} />
          <h3 class="titulo-3"><a href="/refacciones">Refacciones multimarca</a></h3>
          <p class="chico">
            Refacciones para {SITE.marcas.join(", ")}. Cotización con número de parte o con el
            número de serie de la máquina.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="seccion">
    <div class="hoja rejilla rejilla--2 pareja">
      <div>
        <p class="etiqueta">Cobertura</p>
        <h2 class="titulo-2">Dónde entrega BAPSA</h2>
        <div class="filete"></div>
        <p>
          BAPSA entrega con flete propio en <strong>Ramos Arizpe</strong>,
          <strong>Saltillo</strong> y <strong>Arteaga</strong>, que es el corredor donde está
          concentrada la industria de la región: los parques industriales de Ramos Arizpe, la
          zona automotriz y la obra civil de la zona metropolitana de Saltillo. Para obras fuera
          de esa zona se cotiza el traslado.
        </p>
        <p>
          <a href="/cobertura">Ver la zona de cobertura y los tiempos de entrega</a>.
        </p>
      </div>
      <div>
        <PlacaDatos
          banda="ENTREGA"
          registro="FLETE PROPIO"
          titulo="Cobertura y horario"
          renglones={[
            { etiqueta: "Ramos Arizpe", valor: "MISMO DÍA" },
            { etiqueta: "Saltillo", valor: "MISMO DÍA" },
            { etiqueta: "Arteaga", valor: "MISMO DÍA" },
            { etiqueta: "Fuera de zona", valor: "SE COTIZA" },
            { etiqueta: "Horario", valor: "L-V 8:30-18:00" },
          ]}
        />
      </div>
    </div>
  </section>

  <LlamadoAccion />
</Base>


<style>
  /* ── Héroe ─────────────────────────────────────────────────────────────
     La foto llena la pantalla menos la barra. Encima, un velo en Azul BAPSA
     que sube desde abajo y desde la izquierda, donde va el texto, y deja
     limpia la máquina a la derecha. Sin sombras: el velo es la única capa. */
  .heroe {
    position: relative; overflow: hidden; isolation: isolate;
    display: grid; grid-template-rows: 1fr auto; align-items: end;
    min-height: 100svh;
    padding-top: calc(var(--barra) + clamp(var(--e7), 8vw, var(--e9)));
  }
  /* En celular el héroe es más corto: la foto original mide 941px de alto y
     cada pixel de pantalla que se le pida de más es un pixel inventado. */
  @media (max-width: 719px) { .heroe { min-height: 84svh; } }

  .heroe__foto { position: absolute; inset: 0; z-index: -2; display: block; }
  .heroe__img {
    width: 100%; height: 100%; object-fit: cover; object-position: 62% 50%;
    background: none; border: 0;
  }
  @media (max-width: 719px) { .heroe__img { object-position: 74% 50%; } }
  /* La foto llega un 6% más cerca y se asienta en 14 s. Un solo movimiento
     lento, que es lo que hace cinematográfica a la referencia. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 720px) {
    .heroe__img { scale: 1.06; animation: heroe-asienta 14s var(--salida) forwards; }
  }
  @keyframes heroe-asienta { to { scale: 1; } }

  .heroe__velo {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--azul) 22%, transparent) 0%, transparent 30%, color-mix(in srgb, var(--azul) 72%, transparent) 78%, var(--azul) 100%),
      linear-gradient(90deg, color-mix(in srgb, var(--azul) 78%, transparent) 0%, color-mix(in srgb, var(--azul) 45%, transparent) 42%, transparent 70%);
  }
  @media (max-width: 719px) {
    .heroe__velo {
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--azul) 30%, transparent) 0%, color-mix(in srgb, var(--azul) 20%, transparent) 35%, color-mix(in srgb, var(--azul) 84%, transparent) 70%, var(--azul) 100%);
    }
  }

  .heroe__contenido {
    position: relative; display: grid; justify-items: start;
    padding-block: var(--e6) clamp(var(--e7), 8vw, var(--e9));
  }
  @media (max-width: 719px) {
    .heroe__contenido { padding-block: var(--e6) var(--e6); }
    .heroe__titulo { margin-bottom: var(--e4); }
    .heroe__frase { margin-bottom: var(--e5); }
  }
  .heroe__titulo {
    font-size: clamp(2.5rem, 1.1rem + 5.4vw, 4.75rem); font-weight: 800; line-height: 0.96;
    letter-spacing: -0.03em; text-transform: uppercase; color: var(--aire);
    margin: 0 0 var(--e5); max-width: 14ch; text-wrap: balance;
  }
  .heroe__frase {
    font-size: clamp(1.0625rem, 0.9rem + 0.7vw, 1.3125rem); line-height: 1.55;
    color: var(--cielo-bajo); /* 13.9:1 sobre azul; sobre el velo nunca baja de 7:1 */
    max-width: 36ch; margin: 0 0 var(--e6); text-wrap: balance;
  }
  .heroe__acciones { display: flex; flex-wrap: wrap; gap: var(--e3); }
  @media (max-width: 479px) {
    .heroe__acciones { width: 100%; }
    .heroe__acciones .btn { flex: 1 1 100%; }
  }

  /* Entrada: titular, frase, botones y marcas suben una tras otra. */
  @media (prefers-reduced-motion: no-preference) {
    .heroe__paso {
      opacity: 0; transform: translateY(12px);
      animation: heroe-sube var(--lento) var(--salida) forwards;
      animation-delay: calc(120ms + var(--paso) * 110ms);
    }
  }
  @keyframes heroe-sube { to { opacity: 1; transform: none; } }

  /* ── Marquesina de marcas, al pie del héroe ──────────────────────────
     Dos listas idénticas, cada una con el mismo hueco a la derecha que el
     espacio entre nombres: al desplazarse el 100% de su ancho, la segunda cae
     exactamente donde estaba la primera y el rodado no tiene costura. Se
     detiene bajo el cursor o el foco, para poder leerla. */
  .heroe__marcas {
    position: relative; padding-block: var(--e4) var(--e4);
    border-top: 1px solid color-mix(in srgb, var(--aire) 22%, transparent);
    display: grid; gap: var(--e3); align-items: center;
  }
  @media (min-width: 720px) { .heroe__marcas { grid-template-columns: auto 1fr; gap: var(--e6); } }
  .heroe__marcas-rotulo {
    margin: 0; font-family: var(--rotulo); font-size: var(--etiqueta); font-weight: 700;
    line-height: 1.2; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cielo-bajo);
    white-space: nowrap;
  }
  .marquesina {
    display: flex; overflow: hidden; min-width: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquesina__pista {
    display: flex; flex: none; align-items: center; gap: var(--e7);
    margin: 0; padding: 0 var(--e7) 0 0; list-style: none;
    animation: marquesina-rueda 34s linear infinite;
  }
  .marquesina:hover .marquesina__pista,
  .marquesina:focus-within .marquesina__pista { animation-play-state: paused; }
  .marquesina__pista li {
    display: flex; align-items: center; gap: var(--e7);
    font-family: var(--rotulo); font-weight: 800; font-size: 1.0625rem; line-height: 1;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--cielo-bajo); white-space: nowrap;
  }
  .marquesina__pista li::after { content: ""; width: 6px; height: 6px; background: var(--cielo); flex: none; }
  @keyframes marquesina-rueda { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquesina { -webkit-mask-image: none; mask-image: none; }
    .marquesina__pista { animation: none; flex: 1 1 auto; flex-wrap: wrap; row-gap: var(--e2); padding: 0; }
    .marquesina__pista[aria-hidden="true"] { display: none; }
    .marquesina__pista li:last-child::after { display: none; }
  }

  /* ── Bento de familias ──────────────────────────────────────────────── */
  .familias__titulo { text-align: center; margin-inline: auto; max-width: 22ch; }
  .filete--centrado { margin-inline: auto; margin-bottom: var(--e7); }

  .bento { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--e4); }
  @media (min-width: 720px) { .bento { grid-template-columns: repeat(2, 1fr); } }
  /* En escritorio las celdas no son iguales: la familia principal y la
     última son más anchas, como en la referencia. 7/5 y 5/7 sobre 12. */
  @media (min-width: 980px) {
    .bento { grid-template-columns: repeat(12, 1fr); gap: var(--e5); }
    .celda:nth-child(1) { grid-column: span 7; }
    .celda:nth-child(2) { grid-column: span 5; }
    .celda:nth-child(3) { grid-column: span 5; }
    .celda:nth-child(4) { grid-column: span 7; }
  }
  .celda { min-width: 0; }
  .celda__enlace {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    height: 100%; padding: var(--e3) var(--e3) var(--e6);
    background: var(--placa); border: 1px solid var(--riel); text-decoration: none; color: inherit;
    transition: border-color var(--rapido) ease, background-color var(--rapido) ease;
  }
  /* Levantar sin sombra: el borde pasa a Azul BAPSA y la foto se acerca un
     4 %. Es lo que dicta el sistema. */
  .celda__enlace:hover { border-color: var(--azul); }
  .celda__enlace:hover .celda__ver { color: var(--azul); }

  /* El área visual es la foto, a 16:10. La cifra clave va encima como una
     placa en la esquina inferior izquierda: papel Placa, borde Azul BAPSA. */
