---
import Base from "../layouts/Base.astro";
import Icono from "../components/Icono.astro";
import ContactoDirecto from "../components/ContactoDirecto.astro";
import FiltroCatalogo from "../components/FiltroCatalogo.astro";
import TarjetaMaquina from "../components/TarjetaMaquina.astro";
import FormularioCotizacion from "../components/FormularioCotizacion.astro";
import { SITE } from "../config/seo";
import { MAQUINAS, MAQUINAS_POR_ALTURA, MARCAS_CATALOGO, maquinasDeFamilia } from "../datos/maquinas";
import { FAMILIAS_DATOS } from "../datos/familias";
import { nodoListaMaquinas } from "../lib/schema";

const migas = [
  { nombre: "Inicio", ruta: "/" },
  { nombre: "Equipo", ruta: "/equipo" },
];

const masAlta = MAQUINAS_POR_ALTURA[0];
const masBaja = MAQUINAS_POR_ALTURA[MAQUINAS_POR_ALTURA.length - 1];
const masCarga = [...MAQUINAS].sort((a, b) => parseInt(b.capacidad) - parseInt(a.capacidad))[0];
const masAngosta = [...MAQUINAS].sort((a, b) => parseFloat(a.ancho) - parseFloat(b.ancho))[0];

// Solo entran al filtro las familias que de verdad tienen máquina publicada:
// una pestaña vacía es una promesa que la página no cumple.
const categorias = FAMILIAS_DATOS.filter((f) => maquinasDeFamilia(f.slug).length > 0).map((f) => ({
  id: f.slug,
  nombre: f.etiquetaFiltro,
  cuenta: maquinasDeFamilia(f.slug).length,
}));

const schema = [
  nodoListaMaquinas(
    `${SITE.url}/equipo#catalogo`,
    "Catálogo de equipo de elevación en renta",
    MAQUINAS_POR_ALTURA.map((m) => ({ nombre: `${m.marca} ${m.modelo}`, ruta: `/equipo/${m.slug}` }))
  ),
];
---

<Base
  titulo="Catálogo de equipo de elevación en renta"
  descripcion={`Las ${MAQUINAS.length} máquinas de BAPSA con su ficha de fabricante: altura, capacidad y ancho. Todas eléctricas. Precio y disponibilidad por teléfono.`}
  ruta="/equipo"
  migas={migas}
  schema={schema}
>
  <section class="seccion">
    <div class="hoja">
      <p class="etiqueta">Catálogo</p>
      <h1 class="titulo-2">El equipo de BAPSA, máquina por máquina</h1>
      <div class="filete"></div>
      <p class="lede">
        BAPSA renta {MAQUINAS.length} modelos de {MARCAS_CATALOGO.join(" y ")} con altura de
        trabajo entre {masBaja.alturaTrabajo} y {masAlta.alturaTrabajo}. Todos son eléctricos,
        así que entran a una nave en operación, y todos trabajan con 220 kg de carga: una o dos
        personas con su material. Las demás cifras están copiadas de la ficha técnica del
        fabricante.
      </p>

      <h2 class="titulo-2 catalogo__h2">Todas las máquinas en renta</h2>
      <div class="filete"></div>
      <p class="medida catalogo__nota">
        Filtre por tipo de equipo. La disponibilidad no se publica porque cambia todos los días:
        entre a la ficha de la máquina y pídala por teléfono, que es donde se la confirmamos al
        momento.
      </p>
      <FiltroCatalogo categorias={categorias} total={MAQUINAS.length}>
        <ul class="parrilla">
          {
            MAQUINAS_POR_ALTURA.map((m) => (
              <li data-familia={m.familia}>
                <TarjetaMaquina maquina={m} />
              </li>
            ))
          }
        </ul>
      </FiltroCatalogo>
    </div>
  </section>

  <section class="seccion banda--neblina">
    <div class="hoja">
      <ContactoDirecto variante="banda" />
    </div>
  </section>

  <section class="seccion">
    <div class="hoja">
      <h2 class="titulo-2">Las tres que resuelven los casos extremos</h2>
      <div class="filete"></div>
      <ul class="extremos rejilla rejilla--3">
        <li class="tarjeta">
          <Icono nombre="altura" tam={28} />
          <p class="etiqueta">La más alta</p>
          <h3 class="titulo-3">
            <a href={`/equipo/${masAlta.slug}`}>{masAlta.marca} {masAlta.modelo}</a>
          </h3>
          <p class="extremos__cifra dato dato--fuerte">{masAlta.alturaTrabajo}</p>
          <p class="chico">de altura de trabajo. Es el techo del catálogo.</p>
        </li>
        <li class="tarjeta">
          <Icono nombre="placa-datos" tam={28} />
          <p class="etiqueta">La de más carga</p>
          <h3 class="titulo-3">
            <a href={`/equipo/${masCarga.slug}`}>{masCarga.marca} {masCarga.modelo}</a>
          </h3>
          <p class="extremos__cifra dato dato--fuerte">{masCarga.capacidad}</p>
          <p class="chico">de capacidad, entre personas, herramienta y material.</p>
        </li>
        <li class="tarjeta">
          <Icono nombre="plataforma-tijera" tam={28} />
          <p class="etiqueta">La más angosta</p>
          <h3 class="titulo-3">
            <a href={`/equipo/${masAngosta.slug}`}>{masAngosta.marca} {masAngosta.modelo}</a>
          </h3>
          <p class="extremos__cifra dato dato--fuerte">{masAngosta.ancho}</p>
          <p class="chico">de ancho: pasa por una puerta estándar.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="seccion banda--neblina">
    <div class="hoja">
      <h2 class="titulo-2">Comparación rápida</h2>
      <div class="filete"></div>
      <p class="medida">
        Ordenadas de mayor a menor altura de trabajo, que es como se compara este equipo. La
        altura de trabajo ya incluye a una persona de pie en la plataforma: son 2 metros más que
        la altura de plataforma que declara el fabricante.
      </p>
      <div class="tabla-envoltura">
        <table>
          <caption>
            Equipo de elevación en renta de BAPSA. Cifras de las fichas técnicas de Genie y JLG.
          </caption>
          <thead>
            <tr>
              <th scope="col">Modelo</th>
              <th scope="col">Tipo</th>
              <th scope="col" class="cifra">Altura de trabajo</th>
              <th scope="col" class="cifra">Capacidad</th>
              <th scope="col" class="cifra">Ancho</th>
              <th scope="col">Alimentación</th>
            </tr>
          </thead>
          <tbody>
            {
              MAQUINAS_POR_ALTURA.map((m) => (
                <tr>
                  <th scope="row">
                    <a href={`/equipo/${m.slug}`}>
                      {m.marca} {m.modelo}
                    </a>
                  </th>
                  <td>{m.tipo}</td>
                  <td class="cifra">{m.alturaTrabajo}</td>
                  <td class="cifra">{m.capacidad}</td>
                  <td class="cifra">{m.ancho}</td>
                  <td>{m.alimentacion}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="chico">
        Todo el catálogo es <strong>eléctrico</strong>. BAPSA no renta equipo de combustión por
        ahora, así que si su obra es sobre terreno sin compactar o con pendiente fuerte,
        {" "}<a href={`tel:${SITE.telephone}`}>llame</a> y le decimos con franqueza si le podemos
        servir.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="hoja">
      <FormularioCotizacion />
    </div>
  </section>
</Base>

<style>
  /* Auto-ajuste: 1 columna en celular, 2 en tableta, 3 o 4 en escritorio,
     sin un solo media query. */
  .catalogo__h2 { margin-top: var(--e8); }
  .catalogo__nota { margin-bottom: var(--e6); }

  .parrilla {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: var(--e5);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .parrilla > li { display: flex; }
  .parrilla > li > :global(*) { width: 100%; }

  .extremos { list-style: none; padding: 0; margin: var(--e6) 0 0; }
  .extremos .etiqueta { margin-bottom: var(--e1); }
  .extremos h3 { margin-bottom: var(--e2); }
  .extremos h3 a { color: var(--azul); text-decoration: none; }
  .extremos h3 a:hover { color: var(--senal); text-decoration: underline; }
  .extremos__cifra { font-size: 1.75rem; color: var(--azul); margin: 0; line-height: 1.1; }
  .extremos .chico { margin: 0; color: var(--acero); }

  .banda--neblina table a { color: var(--azul); font-weight: 600; }
</style>
