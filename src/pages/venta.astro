---
import Base from "../layouts/Base.astro";
import PlacaDatos from "../components/PlacaDatos.astro";
import Foto from "../components/Foto.astro";
import { FOTO_SECCION } from "../datos/fotos";
import LlamadoAccion from "../components/LlamadoAccion.astro";
import { SITE, ciudadesTexto } from "../config/seo";
import { nodoServicio } from "../lib/schema";

const migas = [
  { nombre: "Inicio", ruta: "/" },
  { nombre: "Venta", ruta: "/venta" },
];
const schema = [
  nodoServicio({
    nombre: "Venta de equipo de elevación",
    descripcion:
      "Venta bajo pedido de plataformas aéreas y brazos articulados, y renta anual con tarifa especial para uso continuo, en Coahuila y Nuevo León.",
    ruta: "/venta",
    tipo: "Venta de maquinaria de elevación",
  }),
];
---

<Base
  titulo="Venta de equipo de elevación y renta anual"
  descripcion="BAPSA vende equipo de elevación bajo pedido. Si la máquina se va a usar todo el año, la renta anual con tarifa especial suele salir mejor. Cotización el mismo día."
  ruta="/venta"
  migas={migas}
  schema={schema}
>
  {/* El negocio de BAPSA es la renta. Esta página atiende a quien llega
      buscando comprar, pero no intenta convencerlo: le ofrece primero la
      renta anual con tarifa especial y deja la venta como opción bajo pedido. */}
  <section class="seccion">
    <div class="hoja encabezado">
      <div>
        <p class="etiqueta">Venta y renta anual</p>
        <h1 class="titulo-2">¿Necesita la máquina todo el año?</h1>
        <div class="filete"></div>
        <p class="lede">
          BAPSA vende equipo de elevación bajo pedido, pero lo que hacemos todos los días es
          rentarlo. Si la máquina se va a quedar en su planta todo el año, pregunte primero por la
          <strong>renta anual con tarifa especial</strong>: tiene el equipo de planta sin
          comprarlo, y el mantenimiento y las fallas siguen del lado de BAPSA.
        </p>
        <div class="apilado">
          <a class="btn btn--relleno" href="/contacto">Cotizar renta anual</a>
          <a class="btn btn--azul" href="/contacto">Cotizar una compra</a>
        </div>
      </div>
      <Foto
        imagen={FOTO_SECCION.venta}
        alt="Brazos articulados Genie y JLG de la flota de BAPSA elevados en el patio de Ramos Arizpe."
        clave="FOTO-07"
        ancho={800}
        alto={600}
        prioritaria
      />
    </div>
  </section>

  <section class="seccion banda--neblina">
    <div class="hoja rejilla rejilla--2 pareja">
      <div>
        <h2 class="titulo-2">Renta anual con tarifa especial</h2>
        <div class="filete"></div>
        <ul class="lista-marcada">
          <li>
            <strong>Tarifa especial por contrato anual</strong>, más baja que la renta por mes.
            Se cotiza según la máquina y el trabajo.
          </li>
          <li>
            <strong>Taller propio en Ramos Arizpe</strong> y respaldo por falla mecánica durante
            todo el contrato.
          </li>
          <li>
            <strong>Entrega y recolección con flete propio</strong> en {ciudadesTexto}.
          </li>
          <li>
            <strong>La máquina no se queda en su balance</strong>: cuando termina el contrato,
            la regresa.
          </li>
        </ul>
        <p class="chico">
          La tarifa y las condiciones del contrato se confirman al cotizar.
        </p>
      </div>
      <PlacaDatos
        banda="RENTA ANUAL"
        registro="BAPSA"
        titulo="Lo que incluye la renta anual"
        renglones={[
          { etiqueta: "Tarifa", valor: "ESPECIAL" },
          { etiqueta: "Taller", valor: "PROPIO" },
          { etiqueta: "Flete", valor: "PROPIO" },
          { etiqueta: "Falla mecánica", valor: "RESPALDADA" },
          { etiqueta: "Cotización", valor: "MISMO DÍA HÁBIL" },
        ]}
      />
    </div>
  </section>

  <section class="seccion">
    <div class="hoja">
      <h2 class="titulo-2">Si de todos modos prefiere comprar</h2>
      <div class="filete"></div>
      <p class="medida">
        BAPSA consigue el equipo bajo pedido y lo respalda con el mismo taller y las mismas
        refacciones de su flota de renta: refacciones para {SITE.marcas.join(", ")} y póliza de
        mantenimiento preventivo opcional. Los modelos, plazos de entrega y garantía se
        confirman al cotizar.
      </p>
      <a class="btn btn--azul" href="/contacto">Cotizar una compra</a>
    </div>
  </section>

  <LlamadoAccion
    titulo="¿La va a usar todo el año? Pregunte por la renta anual"
    texto="Marque con el trabajo, la altura y el tiempo que la necesita, y le cotizamos la tarifa especial el mismo día hábil."
  />
</Base>

<style>
  .encabezado { display: grid; gap: var(--e6); align-items: center; }
  @media (min-width: 900px) { .encabezado { grid-template-columns: 1.15fr 1fr; gap: var(--e8); } }
  .encabezado h1 { margin-bottom: var(--e5); }
  .pareja { align-items: start; }
  @media (min-width: 900px) { .pareja { grid-template-columns: 1.3fr 1fr; gap: var(--e8); } }

</style>
