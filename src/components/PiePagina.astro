---
/**
 * Pie. Lleva el NAP completo en texto —nunca dentro de una imagen— porque es
 * lo que un motor generativo lee para resolver quién es esta entidad, y tiene
 * que coincidir letra por letra con el JSON-LD y con Google Business Profile.
 */
import { SITE, direccionUnaLinea, urlWhatsapp } from "../config/seo";
import { NAV_PIE } from "../config/navegacion";
import Icono from "./Icono.astro";
import LogoWhatsApp from "./LogoWhatsApp.astro";
const anio = new Date().getFullYear();
---

<footer class="pie banda--azul">
  <div class="hoja">
    <div class="pie__rejilla">
      <div class="pie__marca">
        <img class="pie__logo" src="/brand/bapsa-logo-claro.png" width="720" height="311" alt="BAPSA — Trabajando por tu seguridad" />
        <p class="pie__lema">Equipo de elevación · Ramos Arizpe, Coahuila</p>
        <p class="pie__desc">{SITE.description}</p>
      </div>

      {
        NAV_PIE.map((grupo) => (
          <nav class="pie__grupo" aria-label={grupo.titulo}>
            <p class="etiqueta">{grupo.titulo}</p>
            <ul>
              {grupo.entradas.map((e) => (
                <li>
                  <a href={e.ruta}>{e.nombre}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="pie__contacto">
        <p class="etiqueta">Contacto</p>
        <ul>
          <li>
            <LogoWhatsApp tam={16} />
            <a class="dato" href={urlWhatsapp} rel="noopener" target="_blank" aria-label={`WhatsApp ${SITE.telephoneDisplay}`}>{SITE.telephoneDisplay}</a>
          </li>
          <li>
            <Icono nombre="telefono" tam={16} />
            <span class="pie__oficina">
              Oficina:{" "}
              {SITE.oficinas.map((o, i) => (
                <>{i > 0 && " · "}<a class="dato" href={`tel:${o.telephone}`}>{o.display}</a></>
              ))}
            </span>
          </li>
          <li>
            <Icono nombre="correo" tam={16} />
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
          <li>
            <Icono nombre="cobertura" tam={16} />
            <address>{direccionUnaLinea}</address>
          </li>
          <li>
            <Icono nombre="horario" tam={16} />
            <span>{SITE.openingHoursDisplay}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="pie__base">
      <p>© {anio} {SITE.legalName} Todos los derechos reservados.</p>
      <p>
        Sitio por <a href="https://sarapeweb.com" rel="noopener">Sarape Estudio Web</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .pie { padding-block: var(--e8) var(--e5); margin-top: var(--e9); }
  .pie__rejilla { display: grid; gap: var(--e6); }
  @media (min-width: 760px) { .pie__rejilla { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .pie__rejilla { grid-template-columns: 1.5fr repeat(3, 1fr) 1.3fr; } }

  .pie__logo { display: block; height: 72px; width: auto; background: none; margin: 0 0 var(--e3); }
  .pie__lema {
    font-family: var(--rotulo); font-weight: 600; font-size: 0.625rem; line-height: 1.3;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--canastilla);
    margin: 0 0 var(--e4);
  }
  .pie__desc { font-size: var(--pie-foto); line-height: 1.6; color: var(--riel); max-width: 34ch; }

  .pie ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--e3); }
  .pie a { color: var(--aire); text-decoration: none; font-size: var(--cuerpo-chico); }
  .pie a:hover { color: var(--canastilla); text-decoration: underline; }
  .pie__contacto li { display: flex; align-items: flex-start; gap: var(--e3); font-size: var(--cuerpo-chico); }
  .pie__contacto address { font-style: normal; line-height: 1.5; color: var(--riel); }
  .pie__contacto span { color: var(--riel); }

  .pie__base {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--e3);
    margin-top: var(--e7); padding-top: var(--e5); border-top: 1px solid var(--cielo);
    font-size: var(--pie-foto); color: var(--riel);
  }
  .pie__base p { margin: 0; max-width: none; }
</style>
