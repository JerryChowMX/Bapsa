---
/**
 * Estado de una máquina: punto, palabra y dato, siempre los tres.
 * Quien no distingue el verde del rojo sigue leyendo "Disponible · entrega hoy".
 * Los tres colores de estado no son colores de marca y viven fuera de la paleta.
 */
export interface Props {
  tipo: "disponible" | "mantenimiento" | "rentada";
  dato: string;
}
const { tipo, dato } = Astro.props;
const PALABRA = { disponible: "Disponible", mantenimiento: "En mantenimiento", rentada: "Rentada" } as const;
const CLASE = { disponible: "estado--ok", mantenimiento: "estado--espera", rentada: "estado--alto" } as const;
---

<span class={`estado ${CLASE[tipo]}`}>
  {PALABRA[tipo]}
  <span class="estado__dato">· {dato}</span>
</span>
