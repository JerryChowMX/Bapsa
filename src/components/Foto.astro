---
/**
 * Envoltura de imagen.
 *
 * Obliga a `alt`, `width` y `height` en toda foto: sin dimensiones explícitas
 * el layout salta al cargar y el CLS se dispara, y sin `alt` la imagen no
 * existe para nadie que no la vea.
 *
 * Si `src` viene vacío, no emite un <img> roto: pinta un hueco rotulado con
 * la foto que falta. Es deliberado —el material fotográfico del cliente aún
 * no está en el repositorio— y hace imposible publicar sin darse cuenta.
 * Ver FOTOS-PENDIENTES.md.
 */
import { Picture } from "astro:assets";

export interface Props {
  src?: string;
  /** Foto de src/fotos: sale optimizada en AVIF y WebP con varios anchos. */
  imagen?: ImageMetadata;
  /** Rótulo chico sobre la foto, p. ej. "Foto ilustrativa". */
  rotulo?: string;
  alt: string;
  ancho: number;
  alto: number;
  /** La imagen del LCP (la del héroe) va sin lazy y con prioridad de descarga. */
  prioritaria?: boolean;
  /** Llena el contenedor con object-fit: cover, en vez de respetar su proporción. */
  cubrir?: boolean;
  pie?: string;
  clave?: string;
  class?: string;
}
const {
  src, imagen, rotulo, alt, ancho, alto, prioritaria = false, pie, clave, cubrir = false, class: clase = "",
} = Astro.props;
---

{
  imagen ? (
    <figure class={`foto ${cubrir ? "foto--cubrir" : ""} ${clase}`}>
      <Picture
        src={imagen}
        formats={["avif", "webp"]}
        widths={[ancho, Math.min(ancho * 2, imagen.width)]}
        sizes={`(min-width: 900px) ${ancho}px, 100vw`}
        alt={alt}
        width={ancho}
        height={alto}
        loading={prioritaria ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={prioritaria ? "high" : "auto"}
      />
      {rotulo && <span class="foto__rotulo">{rotulo}</span>}
      {pie && <figcaption class="pie-foto">{pie}</figcaption>}
    </figure>
  ) : src ? (
    <figure class={`foto ${cubrir ? "foto--cubrir" : ""} ${clase}`}>
      <img
        src={src}
        alt={alt}
        width={ancho}
        height={alto}
        loading={prioritaria ? "eager" : "lazy"}
        decoding={prioritaria ? "sync" : "async"}
        fetchpriority={prioritaria ? "high" : "auto"}
      />
      {pie && <figcaption class="pie-foto">{pie}</figcaption>}
    </figure>
  ) : (
    <figure
      class={`foto foto--hueco ${cubrir ? "foto--cubrir" : ""} ${clase}`}
      style={`--proporcion:${ancho} / ${alto}`}
    >
      <div class="hueco">
        <span class="etiqueta">Foto pendiente</span>
        <p class="hueco__alt">{alt}</p>
        {clave && <p class="dato hueco__clave">{clave}</p>}
        <p class="dato hueco__medida">
          {ancho}&nbsp;×&nbsp;{alto}
        </p>
      </div>
      {pie && <figcaption class="pie-foto">{pie}</figcaption>}
    </figure>
  )
}

<style>
  .foto { margin: 0; position: relative; }
  /* :global porque el <img> de <Picture> no lleva el atributo de alcance.
     Las fotos de src/fotos vienen en 16:9; el ancho y alto que se piden
     fijan la proporción de la caja y object-fit recorta sin deformar. */
  .foto :global(img) { width: 100%; height: auto; object-fit: cover; border: 1px solid var(--riel); }
  .foto__rotulo {
    position: absolute; left: var(--e3); top: var(--e3);
    font-family: var(--rotulo); font-size: 0.625rem; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    background: var(--aire); color: var(--azul); padding: var(--e1) var(--e2);
  }

  /* Modo tarjeta: el hueco lo manda el contenedor, no la proporción. */
  .foto--cubrir { height: 100%; }
  .foto--cubrir :global(picture) { display: block; height: 100%; }
  .foto--cubrir :global(img) { height: 100%; border: 0; }
  .foto--cubrir .hueco { aspect-ratio: auto; height: 100%; border-width: 0 0 1px 0; }

  .hueco {
    aspect-ratio: var(--proporcion);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--e2); padding: var(--e5); text-align: center;
    background: var(--neblina);
    border: 2px dashed var(--acero);
  }
  .hueco .etiqueta { margin: 0; color: var(--senal); }
  .hueco__alt {
    margin: 0; max-width: 42ch; font-size: var(--cuerpo-chico);
    line-height: 1.5; color: var(--chasis);
  }
  .hueco__clave { margin: 0; font-size: 0.75rem; color: var(--azul); font-weight: 700; }
  .hueco__medida { margin: 0; font-size: 0.6875rem; color: var(--acero); }
</style>
